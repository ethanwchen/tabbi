{
  "formatVersion": 1,
  "id": "student",
  "pickerOrder": 3,
  "name": "Student",
  "summary": "A study timer, today's classes and homework, and music to focus.",
  "symbol": "graduationcap.fill",
  "accent": "planner",
  "modules": ["study", "planner", "spotify", "claudeAsk", { "id": "anki", "enabled": false }, "closet"],
  "defaults": {
    "ticker": ["focus", "tasks", "progress", "meeting", "nowPlaying", "pet"],
    "theme": "midnight",
    "moduleSettings": {
      "study": {
        "methods": ["pomodoro", "fiftyTwoSeventeen", "flowtime", "custom"],
        "method": "pomodoro"
      },
      "focus": { "sounds": [{ "sound": "cafe", "level": 0.7 }] },
      "closet": {
        "pet": { "breed": "corgi" },
        "coachLines": {
          "distraction": [
            "Your homework is saving your seat. Back for a bit?",
            "Your essay is ready when you are. Head back?"
          ],
          "idleCheck": ["Working a problem on paper? Tap if you're here."]
        }
      }
    }
  },
  "onboarding": [
    {
      "id": "level",
      "prompt": "What are you studying for?",
      "options": [
        { "id": "high-school", "label": "High school", "symbol": "backpack" },
        { "id": "college", "label": "College", "symbol": "building.columns" },
        { "id": "exam", "label": "A big exam", "symbol": "pencil.and.list.clipboard" }
      ]
    },
    {
      "id": "flashcards",
      "prompt": "Do you study with flashcards?",
      "options": [
        { "id": "anki", "label": "Yes, in Anki", "symbol": "rectangle.stack", "enables": ["anki"] },
        { "id": "no", "label": "No", "symbol": "xmark" }
      ]
    }
  ],
  "starterTasks": ["Review today's lecture notes", "Plan this week's assignments"]
}
