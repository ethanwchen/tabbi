{
  "formatVersion": 1,
  "id": "medicine",
  "pickerOrder": 2,
  "name": "Med School",
  "summary": "A study timer, Anki reviews, study parties, and a study pet for med school.",
  "symbol": "cross.case.fill",
  "modules": ["study", "planner", "anki", "party", "spotify", "claudeAsk", "closet"],
  "defaults": {
    "ticker": ["focus", "tasks", "progress", "party", "meeting", "nowPlaying", "pet"],
    "theme": "notch",
    "moduleSettings": {
      "study": {
        "methods": ["pomodoro", "ankiSprint", "questionBlock", "fiftyTwoSeventeen", "ultradian", "flowtime", "custom"],
        "method": "pomodoro",
        "dailyGoalMinutes": 240
      },
      "focus": { "sounds": [{ "sound": "rain", "level": 0.8 }, { "sound": "brown", "level": 0.4 }] },
      "planner": {
        "planMode": "study",
        "reviewsFirst": true,
        "eventBufferMinutes": 10,
        "studyBlockTitle": "Study block",
        "upNextEvents": "lectures, labs, and shifts",
        "dayEndHour": 21,
        "sampleDay": "medicine"
      },
      "closet": {
        "pet": { "breed": "orangeTabby" },
        "coachLines": {
          "distraction": [
            "Your flashcards miss you. Back for a few more?",
            "The Krebs cycle is saving your seat.",
            "Psst, the next card might be the one on the exam.",
            "Back to cardiology? Your heart notes are waiting.",
            "Even residents check their phones. Back when ready."
          ],
          "offerPause": ["Step off the wards for a bit? I'll hold your spot."],
          "idleCheck": [
            "Deep in First Aid? Just checking you're here.",
            "Thinking through a vignette? Tap if you're here."
          ]
        }
      }
    }
  },
  "onboarding": [
    {
      "id": "stage",
      "prompt": "Where are you in training?",
      "options": [
        {
          "id": "preclinical",
          "label": "Preclinical (Step 1)",
          "symbol": "books.vertical",
          "tasks": ["Clear today's Anki reviews", "Do one block of UWorld questions"]
        },
        {
          "id": "clinical",
          "label": "Clinical rotations (Step 2)",
          "symbol": "stethoscope",
          "tasks": ["Clear today's Anki reviews", "Do 20 shelf questions"]
        },
        {
          "id": "other",
          "label": "Something else",
          "symbol": "graduationcap",
          "tasks": ["Plan today's study blocks"]
        }
      ]
    },
    {
      "id": "anki",
      "prompt": "Do you use Anki?",
      "options": [
        { "id": "yes", "label": "Yes, every day", "symbol": "rectangle.stack", "enables": ["anki"] },
        { "id": "no", "label": "Not right now", "symbol": "xmark", "disables": ["anki"] }
      ]
    }
  ],
  "starterTasks": []
}
