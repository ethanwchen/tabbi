    "Up next shows your %@ as the day goes, and Plan my day fits work around them." : {
      "comment" : "Onboarding calendar step. %@ is a lowercase plural phrase such as 'meetings and calls'. Up next and Plan my day are feature names.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Als Nächstes“ zeigt deine %@ im Laufe des Tages, und „Tag planen“ plant deine Arbeit drumherum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A continuación muestra tus %@ a lo largo del día, y Planear mi día encaja el trabajo en los huecos."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasa Susunod ang mga %@ mo, at isinisingit ng Planuhin ang araw ang trabaho sa pagitan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À venir affiche tes %@ au fil de la journée, et Planifier ma journée place ton travail autour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「次の予定」で1日の%@を確認でき、「1日を計画」がその合間に作業を組み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 일정에서 하루의 %@을 보여 주고, 하루 계획이 그 사이에 작업을 넣어 줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seguir mostra %@ ao longo do dia, e Planejar meu dia encaixa o trabalho nos intervalos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Далее» показывает твои %@ в течение дня, а «План дня» распределяет дела вокруг них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“接下来”会随时显示你的%@，“规划今天”会围绕它们安排工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「接下來」會隨時顯示你的%@，「規劃今天」會配合它們安排工作。"
          }
        }
      }
    },
