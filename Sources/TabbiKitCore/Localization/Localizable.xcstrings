    "Allow %@ in Privacy & Security to plan around meetings." : {
      "comment" : "Today panel, Plan my day (AI or on-device plan of focus blocks around calendar events). %@ is the app name Tabbi. Privacy & Security is the macOS System Settings pane, use its localized name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube %@ unter Datenschutz & Sicherheit, um um Meetings herum zu planen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite %@ en Privacidad y seguridad para planear alrededor de tus reuniones."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payagan ang %@ sa Privacy & Security para makapagplano sa paligid ng mga meeting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise %@ dans Confidentialité et sécurité pour planifier autour des réunions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会議に合わせて計画するには、「プライバシーとセキュリティ」で %@ を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회의에 맞춰 계획하려면 개인정보 보호 및 보안에서 %@를 허용해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o %@ em Privacidade e Segurança para planejar em torno das reuniões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разреши доступ для %@ в разделе «Конфиденциальность и безопасность», чтобы планировать с учетом встреч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
