    "%@ Showing the last known status. Click to retry." : {
      "comment" : "Party: tooltip on the warning icon in the friends list; %@ is an error message sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Zeige den letzten bekannten Status. Klicke für einen neuen Versuch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Se muestra el último estado conocido. Haz clic para reintentar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ipinapakita ang huling alam na status. I-click para subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Dernier statut connu affiché. Clique pour réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 最後に確認した状態を表示しています。クリックして再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 마지막으로 확인된 상태를 표시합니다. 클릭하여 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Mostrando o último status conhecido. Clique para tentar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Показан последний известный статус. Нажми, чтобы повторить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 显示的是最后已知状态。点按以重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 目前顯示最後已知的狀態。點一下以重試。"
          }
        }
      }
    },
    "%@ Themes style the open panel; the closed notch stays black." : {
      "comment" : "Footer in Settings > Look; %@ is the selected theme's one-sentence summary.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Designs gestalten das offene Panel, die geschlossene Notch bleibt schwarz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Los temas cambian el panel abierto; el notch cerrado sigue negro."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Binabago ng mga theme ang bukas na panel; nananatiling itim ang saradong notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Les thèmes habillent le panneau ouvert ; l'encoche fermée reste noire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ テーマは開いたパネルに適用され、閉じたノッチは黒のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 테마는 열린 패널에 적용되고, 닫힌 노치는 검은색 그대로예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Os temas mudam o painel aberto; o notch fechado continua preto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Темы меняют открытую панель, закрытый вырез остается черным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 主题会改变展开的面板，收起的刘海保持黑色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 主題會改變展開的面板，收起的瀏海仍維持黑色。"
          }
        }
      }
    },
