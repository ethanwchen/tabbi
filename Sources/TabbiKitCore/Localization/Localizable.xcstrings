          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un kit, c'est un ensemble d'onglets prêt à l'emploi. En changer remplace tes onglets et ajoute ses tâches de départ à Aujourd'hui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
