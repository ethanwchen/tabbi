    "That key can't be part of a shortcut. Try a letter, number, or Space." : {
      "comment" : "Settings > General error when recording a shortcut with an unsupported key.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Taste geht nicht für einen Kurzbefehl. Probier einen Buchstaben, eine Zahl oder die Leertaste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa tecla no puede ser parte de un atajo. Prueba con una letra, un número o Espacio."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi puwede ang key na iyan sa shortcut. Subukan ang letra, numero, o Space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette touche ne peut pas faire partie d'un raccourci. Essaie une lettre, un chiffre ou Espace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのキーはショートカットに使えません。文字、数字、またはスペースを試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 키는 단축키에 쓸 수 없어요. 글자, 숫자 또는 Space를 써 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa tecla não pode fazer parte de um atalho. Tente uma letra, um número ou Espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эту клавишу нельзя использовать в сочетании. Попробуй букву, цифру или пробел."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个键不能用于快捷键。试试字母、数字或空格键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個鍵不能用在快速鍵中。試試字母、數字或空白鍵。"
          }
        }
      }
    },
    "That name and your pet's name aren't allowed. Please pick others." : {
