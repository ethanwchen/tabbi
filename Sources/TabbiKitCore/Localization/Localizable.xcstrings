        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung aling display ang magpapakita ng notch. Babalik ito sa built-in na display kapag na-disconnect ang display na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis l'écran qui affiche l'encoche. S'il est débranché, l'écran intégré prend le relais."
