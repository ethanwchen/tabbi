    "Reduce Motion is on, so changes fade instead of moving." : {
      "comment" : "Settings > General footer; Reduce Motion is the macOS Accessibility setting, use its official name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bewegung reduzieren“ ist aktiv, daher blenden Änderungen über statt sich zu bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducir movimiento está activado, así que los cambios se funden en vez de moverse."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-on ang Reduce Motion, kaya nagfe-fade ang mga pagbabago imbes na gumalaw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Réduire les animations » est activé : les changements s'estompent au lieu de bouger."
          }
