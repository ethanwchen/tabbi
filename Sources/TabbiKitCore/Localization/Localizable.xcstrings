    "AnkiConnect's settings keep Tabbi out. Putting them back to normal fixes it and leaves your cards alone." : {
      "comment" : "Setup walkthrough or permission priming sheet in Settings > Connections.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen von AnkiConnect sperren Tabbi aus. Zurücksetzen behebt das, deine Karten bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes de AnkiConnect dejan fuera a Tabbi. Restablecerlos lo arregla y no toca tus tarjetas."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinaharangan ng settings ng AnkiConnect ang Tabbi. Maaayos ito kapag ibinalik sa default, at hindi gagalawin ang cards mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages d'AnkiConnect bloquent Tabbi. Les remettre par défaut règle le problème sans toucher à tes cartes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiConnectの設定がTabbiの接続を妨げています。設定を元に戻せば解決し、カードには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiConnect 설정 때문에 Tabbi가 접속하지 못하고 있어요. 설정을 기본값으로 되돌리면 해결되고, 카드는 그대로예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ajustes do AnkiConnect bloqueiam o Tabbi. Voltar ao padrão resolve e não mexe nos seus cartões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки AnkiConnect не пускают Tabbi. Сброс к стандартным все исправит, а карточки не тронет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiConnect 的设置挡住了 Tabbi。恢复默认设置即可解决，你的卡片不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiConnect 的設定擋住了 Tabbi。恢復成預設值就能解決，你的卡片不會受影響。"
          }
        }
      }
    },
    "Another steady week. Keep it cozy." : {
      "comment" : "Weekly recap card: the one warm line about the week.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
