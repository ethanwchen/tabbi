    "This link doesn't match anyone now. Ask your friend for a new one." : {
      "comment" : "Party invite card (opened from an invite link): message.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link passt gerade zu niemandem. Bitte deinen Freund um einen neuen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este enlace ya no corresponde a nadie. Pide uno nuevo a tu amigo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala nang tumutugma sa link na ito. Humingi ng bago sa kaibigan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien ne correspond plus à personne. Demande-en un nouveau à ton ami."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリンクは今は誰にもつながっていません。友達に新しいリンクをもらってください。"
          }
        },
        "ko" : {
