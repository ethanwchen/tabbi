    "A kit is a set of tabs. You can change them any time." : {
      "comment" : "Onboarding hint on the kit step.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kit ist eine Auswahl an Tabs. Jederzeit änderbar."
