          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вырез видишь только ты, а не зрители и не записи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有你能看到刘海，观众和录屏都看不到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有你看得到瀏海，觀眾和錄影都看不到。"
          }
        }
      }
    },
    "Only your name, pet, study status and minutes are shared. Nothing about your cards, decks or what you study ever leaves your Mac." : {
      "comment" : "Settings pane text (Ask AI, Pet Coach, daily reminder or Party).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteilt werden nur Name, Haustier, Lernstatus und Minuten. Nichts über deine Karten, Stapel oder Lerninhalte verlässt deinen Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se comparten tu nombre, mascota, estado y minutos de estudio. Nada de tus tarjetas, mazos o lo que estudias sale de tu Mac."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangalan, pet, study status at minutes mo lang ang shini-share. Walang lumalabas sa Mac mo tungkol sa cards, decks o pinag-aaralan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls ton nom, ton compagnon, ton statut et tes minutes d'étude sont partagés. Rien sur tes cartes, paquets ou sujets ne quitte ton Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有されるのは名前、ペット、勉強中かどうか、勉強時間だけ。カードやデッキ、勉強内容がMacの外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름, 펫, 공부 상태와 시간만 공유돼요. 카드, 덱, 공부 내용은 절대 Mac 밖으로 나가지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só seu nome, pet, status e minutos de estudo são compartilhados. Nada dos seus cards, baralhos ou do que você estuda sai do Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передаются только имя, питомец, статус и минуты учебы. Ничего о твоих карточках, колодах и предметах не покидает Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会分享你的名字、宠物、学习状态和时长。你的卡片、牌组和学习内容绝不会离开你的 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只分享你的名字、寵物、讀書狀態和分鐘數。卡片、牌組和讀書內容絕不會離開你的 Mac。"
          }
        }
      }
    },
