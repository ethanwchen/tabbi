    "That key can't be part of a shortcut. Try a letter, number, or Space." : {
      "comment" : "Settings > General error when recording a shortcut with an unsupported key.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Taste geht nicht für einen Kurzbefehl. Probier einen Buchstaben, eine Zahl oder die Leertaste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa tecla no puede ser parte de un atajo. Prueba con una letra, un número o Espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette touche ne peut pas faire partie d'un raccourci. Essaie une lettre, un chiffre ou Espace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのキーはショートカットに使えません。文字、数字、またはスペースを試してください。"
