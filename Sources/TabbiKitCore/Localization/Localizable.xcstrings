    "%@ Fix it in Settings > Tabs > Party > Options, or clear it to use the Tabbi server." : {
      "comment" : "Party: detail when the custom server is invalid; %@ is a sentence saying what is wrong.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Korrigiere ihn unter Einstellungen > Tabs > Party > Optionen oder leere ihn, um den Tabbi-Server zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Corrígelo en Ajustes > Pestañas > Grupo > Opciones, o bórralo para usar el servidor de Tabbi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ayusin ito sa Settings > Tabs > Party > Options, o burahin ito para gamitin ang server ng Tabbi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Corrige-le dans Réglages > Onglets > Groupe > Options, ou efface-le pour utiliser le serveur Tabbi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 設定 > タブ > パーティ > オプションで修正するか、空にしてTabbiのサーバーを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 설정 > 탭 > 파티 > 옵션에서 수정하거나, 비워서 Tabbi 서버를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Corrija em Ajustes > Abas > Grupo > Opções, ou apague para usar o servidor do Tabbi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Исправь его в Настройки > Вкладки > Party > Параметры или очисти поле, чтобы использовать сервер Tabbi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请在“设置 > 标签页 > 派对 > 选项”中修改，或清空以使用 Tabbi 服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 請到「設定 > 標籤頁 > 派對 > 選項」修正，或清空以使用 Tabbi 伺服器。"
          }
        }
      }
    },
