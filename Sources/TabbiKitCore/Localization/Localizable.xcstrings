        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está danificado, então ficou intocado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已损坏，因此保持原样。"
          }
        }
      }
    },
