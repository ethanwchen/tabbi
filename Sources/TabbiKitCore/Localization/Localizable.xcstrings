    "A Pomodoro timer that switches between focus and breaks." : {
      "comment" : "One-line summary of the Focus module in the Settings module library.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Pomodoro-Timer, der zwischen Fokus und Pausen wechselt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un temporizador Pomodoro que alterna enfoque y descansos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un minuteur Pomodoro qui alterne focus et pauses."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中と休憩を切り替えるポモドーロタイマー。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중과 휴식을 번갈아 주는 뽀모도로 타이머."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um timer Pomodoro que alterna foco e pausas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在专注和休息之间切换的番茄钟。"
          }
        }
      }
    },
    "A button at the far right of the tab bar" : {
      "comment" : "Settings > Tabs subtitle for a module that opens from a header button instead of a tab.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Button ganz rechts in der Tableiste"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un botón a la derecha de la barra de pestañas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bouton tout à droite de la barre d'onglets"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブバーの右端にあるボタン"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 막대 맨 오른쪽 버튼"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um botão no canto direito da barra de abas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签栏最右侧的按钮"
          }
        }
      }
    },
    "A card with your week in the notch every Sunday evening." : {
      "comment" : "Settings > General subtitle under Weekly recap.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Sonntagabend eine Karte mit deiner Woche in der Notch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tarjeta con tu semana en el notch cada domingo por la tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une carte avec ta semaine dans l'encoche chaque dimanche soir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎週日曜の夜、1週間のまとめカードをノッチに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매주 일요일 저녁, 노치에 한 주를 담은 카드가 떠요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um cartão com a sua semana no notch todo domingo à noite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周日晚上，在刘海里展示你这一周的卡片。"
          }
        }
      }
    },
    "A cozy everyday companion: a cat in your notch, with your tabs one click away." : {
      "comment" : "Tagline in Settings > About.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gemütlicher Begleiter für jeden Tag: eine Katze in deiner Notch, deine Tabs nur einen Klick entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compañero acogedor para cada día: un gato en tu notch, con tus pestañas a un clic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compagnon douillet au quotidien : un chat dans ton encoche, avec tes onglets à portée de clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日に寄り添う心地よい相棒。ノッチに猫がいて、タブはワンクリックで開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 함께하는 아늑한 친구: 노치 속 고양이와 클릭 한 번이면 열리는 탭."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um companheiro aconchegante para o dia a dia: um gato no seu notch, com suas abas a um clique."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温馨的日常伙伴：刘海里住着一只猫，标签页一点即开。"
          }
        }
      }
    },
    "A daily nudge, in Closet options." : {
      "comment" : "Where to turn on the daily reminder. Closet is a tab name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Stupser am Tag, in den Closet-Optionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aviso diario, en las opciones de Closet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit rappel par jour, dans les options de Closet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closetのオプションで設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closet 옵션에서 매일 알림을 켜요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um lembrete diário, nas opções do Closet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天提醒一下，在 Closet 选项中。"
          }
        }
      }
    },
    "A few extras" : {
      "comment" : "Heading of the last onboarding step, which lists optional features.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein paar Extras"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos extras"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques extras"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おまけ機能"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가 기능"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns extras"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一些小功能"
          }
        }
      }
    },
    "A kit is a ready-made set of tabs. Switching replaces your tabs and adds its starter tasks to Today." : {
      "comment" : "Footer in Settings > Tabs. Today is a module name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kit ist eine fertige Auswahl an Tabs. Ein Wechsel ersetzt deine Tabs und fügt seine Startaufgaben zu Heute hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un kit es un grupo de pestañas listo para usar. Cambiar reemplaza tus pestañas y añade sus tareas iniciales a Hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un kit, c'est un ensemble d'onglets prêt à l'emploi. En changer remplace tes onglets et ajoute ses tâches de départ à Aujourd'hui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キットはすぐ使えるタブのセットです。切り替えるとタブが置き換わり、最初のタスクが「今日」に追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키트는 미리 준비된 탭 묶음이에요. 바꾸면 탭이 바뀌고 시작 할 일이 오늘에 추가돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um kit é um conjunto de abas pronto. Trocar substitui suas abas e adiciona as tarefas iniciais dele ao Hoje."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套件是一组现成的标签页。切换后会替换你的标签页，并把它的初始任务添加到“今天”。"
          }
        }
      }
    },
    "A kit is a set of tabs. You can change them any time." : {
      "comment" : "Onboarding hint on the kit step.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kit ist eine Auswahl an Tabs. Jederzeit änderbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un kit es un grupo de pestañas. Puedes cambiarlas cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un kit, c'est un ensemble d'onglets. Modifiable à tout moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キットはタブのセットです。いつでも変えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키트는 탭 묶음이에요. 언제든 바꿀 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um kit é um conjunto de abas. Dá para mudar quando quiser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套件就是一组标签页，随时可以更改。"
          }
        }
      }
    },
    "A light trackpad tap at the notch edge and on celebrations." : {
      "comment" : "Settings > General subtitle under Haptic feedback.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein leichtes Tippen am Trackpad am Notch-Rand und bei Feiern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un toque suave en el trackpad al llegar al notch y en las celebraciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un léger tapotement du trackpad au bord de l'encoche et lors des célébrations."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチの端やお祝いのときに、トラックパッドが軽く振動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치 가장자리와 축하할 때 트랙패드가 살짝 톡 울려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um toque leve no trackpad na borda do notch e nas comemorações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到达刘海边缘和庆祝时，触控板轻轻一震。"
          }
        }
      }
    },
    "A soft sound when you unlock an item or reach a streak." : {
      "comment" : "Settings > General subtitle under Celebration sound.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein sanfter Klang, wenn du etwas freischaltest oder eine Serie erreichst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sonido suave al desbloquear algo o alcanzar una racha."
          }
