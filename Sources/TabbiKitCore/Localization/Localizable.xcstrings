            "value" : "%@ GB"
          }
        }
      }
    },
    "%@ Showing the last known status. Click to retry." : {
      "comment" : "Party: tooltip on the warning icon in the friends list; %@ is an error message sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Zeige den letzten bekannten Status. Klicke für einen neuen Versuch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Se muestra el último estado conocido. Haz clic para reintentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Dernier statut connu affiché. Clique pour réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 最後に確認した状態を表示しています。クリックして再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 마지막으로 확인된 상태를 표시합니다. 클릭하여 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Mostrando o último status conhecido. Clique para tentar de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 显示的是最后已知状态。点按以重试。"
          }
        }
      }
    },
    "%@ Themes style the open panel; the closed notch stays black." : {
      "comment" : "Footer in Settings > Look; %@ is the selected theme's one-sentence summary.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Designs gestalten das offene Panel, die geschlossene Notch bleibt schwarz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Los temas cambian el panel abierto; el notch cerrado sigue negro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Les thèmes habillent le panneau ouvert ; l'encoche fermée reste noire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ テーマは開いたパネルに適用され、閉じたノッチは黒のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 테마는 열린 패널에 적용되고, 닫힌 노치는 검은색 그대로예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Os temas mudam o painel aberto; o notch fechado continua preto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 主题会改变展开的面板，收起的刘海保持黑色。"
          }
        }
      }
    },
    "%@ Trying again in the background." : {
      "comment" : "Party: detail when the server can't be reached; %@ is an error sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Neuer Versuch im Hintergrund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Reintentando en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nouvel essai en arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ バックグラウンドで再試行しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 백그라운드에서 다시 시도하는 중이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tentando de novo em segundo plano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在后台重试。"
          }
        }
      }
    },
    "%@ can't control %@" : {
      "comment" : "Now Playing title when macOS Automation permission is denied. First %@ is this app's name (Tabbi), second the music app name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kann %2$@ nicht steuern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no puede controlar %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne peut pas contrôler %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%2$@を操作できません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 %2$@을(를) 제어할 수 없어요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %1$@ não consegue controlar o %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 无法控制 %2$@"
          }
        }
      }
    },
