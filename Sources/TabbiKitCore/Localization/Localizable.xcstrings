    },
    "In System Settings, set Tabbi to Full Access under Calendars." : {
      "comment" : "Connection status line in Settings > Connections (Calendar). %@ is an app or connection name, %lld a number.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell Tabbi in den Systemeinstellungen unter Kalender auf Vollzugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Ajustes del Sistema, dale a Tabbi Acceso total en Calendarios."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa System Settings, gawing Full Access ang Tabbi sa ilalim ng Calendars."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Réglages Système, donne à Tabbi l'Accès complet sous Calendriers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定の「カレンダー」で、Tabbiを「フルアクセス」に設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정의 캘린더에서 Tabbi를 전체 접근으로 설정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos Ajustes do Sistema, dê Acesso Total ao Tabbi em Calendários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Системных настройках в разделе «Календари» выбери для Tabbi «Полный доступ»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
