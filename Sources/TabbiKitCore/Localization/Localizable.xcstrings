    "Choose which display shows the notch. It falls back to the built-in display when this one is disconnected." : {
      "comment" : "Tooltip for Show notch on in Settings > General.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, welches Display die Notch zeigt. Ist es getrennt, wird das integrierte Display genutzt."
