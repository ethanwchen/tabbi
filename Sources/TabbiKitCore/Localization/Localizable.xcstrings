    "After %@ closes unexpectedly, ask before sending a crash report, send it without asking, or never send one" : {
      "comment" : "Shown in CrashReportSettingsSection.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn %@ unerwartet beendet wird: vor dem Senden eines Absturzberichts fragen, ihn ohne Nachfrage senden oder nie senden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando %@ se cierre inesperadamente, preguntar antes de enviar un informe de fallos, enviarlo sin preguntar o no enviarlo nunca"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag biglang nagsara ang %@, magtanong muna bago magpadala ng crash report, ipadala nang hindi nagtatanong, o huwag kailanman magpadala"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand %@ se ferme de façon inattendue, demander avant d'envoyer un rapport de plantage, l'envoyer sans demander ou ne jamais l'envoyer"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が予期せず終了したとき、クラッシュレポートを送る前に確認する、確認せずに送る、または送らない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 예기치 않게 종료되면 충돌 보고서를 보내기 전에 묻거나, 묻지 않고 보내거나, 보내지 않아요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o %@ fechar inesperadamente, perguntar antes de enviar um relatório de falhas, enviar sem perguntar ou nunca enviar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если %@ неожиданно закроется: спросить перед отправкой отчета о сбое, отправить без вопроса или никогда не отправлять"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 意外退出时，发送崩溃报告前先询问、不询问直接发送，或从不发送"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 意外結束時，傳送當機報告前先詢問、不詢問直接傳送，或永不傳送"
          }
        }
      }
    },
