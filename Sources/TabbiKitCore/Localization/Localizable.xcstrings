    "Start a party and share its code, or join a friend's. Your pets sit side by side while you focus." : {
      "comment" : "Party: hint when you are in no party.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte eine Party und teile ihren Code oder tritt der eines Freundes bei. Eure Haustiere sitzen nebeneinander, während ihr fokussiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un grupo y comparte su código, o únete al de un amigo. Las mascotas se sientan juntas durante la concentración."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magsimula ng party at i-share ang code nito, o sumali sa party ng kaibigan. Magkatabi ang mga pet n'yo habang nagfo-focus kayo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un groupe et partage son code, ou rejoins celui d'un ami. Vos compagnons s'assoient côte à côte pendant que vous vous concentrez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パーティを作ってコードを共有するか、友達のパーティに参加しましょう。集中している間、ペットが並んで座ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파티를 만들어 코드를 공유하거나 친구의 파티에 참가하세요. 집중하는 동안 펫들이 나란히 앉아 있어요."
          }
        },
        "pt-BR" : {
