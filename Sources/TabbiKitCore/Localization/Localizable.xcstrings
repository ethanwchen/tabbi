    },
    "In System Settings, turn on %@ under Tabbi." : {
      "comment" : "Connection status line in Settings > Connections (Music). %@ is an app or connection name, %lld a number.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte in den Systemeinstellungen %@ unter Tabbi ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Ajustes del Sistema, activa %@ debajo de Tabbi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa System Settings, i-on ang %@ sa ilalim ng Tabbi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Réglages Système, active %@ sous Tabbi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定で、Tabbiの下にある%@をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 Tabbi 아래의 %@ 항목을 켜 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
