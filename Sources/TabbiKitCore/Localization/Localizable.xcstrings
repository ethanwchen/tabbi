    "Your copy of AnkiConnect is too old for Tabbi. Anki can update it in a few clicks." : {
      "comment" : "Setup walkthrough or permission priming sheet in Settings > Connections.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
