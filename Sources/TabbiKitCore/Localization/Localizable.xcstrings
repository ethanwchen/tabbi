          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루를 계획하고 질문에 답해 주는 AI 도우미예요. 다른 기능은 없어도 모두 작동해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É um assistente de IA que planeja seu dia e responde perguntas. Todo o resto funciona sem ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
