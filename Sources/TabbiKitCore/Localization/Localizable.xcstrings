            "value" : "Com %1$@, o %2$@ envia isto para a %3$@ com sua chave de API quando você usa um recurso de IA:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С %1$@ при использовании функций ИИ %2$@ отправляет в %3$@ с твоим ключом API следующее:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
