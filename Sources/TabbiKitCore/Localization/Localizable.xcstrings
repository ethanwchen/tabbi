    "Click Connect, then Allow when your Mac asks if Tabbi can control %@." : {
      "comment" : "Connection status line in Settings > Connections (Music). %@ is an app or connection name, %lld a number.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klick auf Verbinden und dann auf Erlauben, wenn dein Mac fragt, ob Tabbi %@ steuern darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Conectar y luego en Permitir cuando tu Mac pregunte si Tabbi puede controlar %@."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-click ang Ikonekta, tapos Allow kapag tinanong ng Mac mo kung puwedeng kontrolin ng Tabbi ang %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique sur Connecter, puis sur Autoriser quand ton Mac demande si Tabbi peut contrôler %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「接続」をクリックし、Tabbiが%@を操作してよいか尋ねられたら「許可」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결을 클릭한 다음, Tabbi가 %@ 앱을 제어해도 되는지 Mac이 물으면 허용을 클릭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em Conectar e depois em Permitir quando o Mac perguntar se o Tabbi pode controlar %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми «Подключить», а затем «Разрешить», когда Mac спросит, может ли Tabbi управлять %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按“连接”，当 Mac 询问 Tabbi 能否控制 %@ 时，点按“允许”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下「連接」，當 Mac 詢問 Tabbi 是否可以控制 %@ 時，選擇「允許」。"
          }
        }
      }
    },
    "Click Connect, then Allow when your Mac asks. It only asks once." : {
      "comment" : "Connection status line in Settings > Connections (Notifications). %@ is an app or connection name, %lld a number.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klick auf Verbinden und dann auf Erlauben, wenn dein Mac fragt. Er fragt nur einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Conectar y luego en Permitir cuando tu Mac pregunte. Solo pregunta una vez."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-click ang Ikonekta, tapos Allow kapag nagtanong ang Mac mo. Isang beses lang itong magtatanong."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique sur Connecter, puis sur Autoriser quand ton Mac le demande. Il ne demande qu'une fois."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「接続」をクリックし、Macに尋ねられたら「許可」を選んでください。確認は一度だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결을 클릭한 다음, Mac이 물으면 허용을 클릭하세요. 한 번만 물어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em Conectar e depois em Permitir quando o Mac perguntar. Ele só pergunta uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми «Подключить», а затем «Разрешить», когда Mac спросит. Он спросит только раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
