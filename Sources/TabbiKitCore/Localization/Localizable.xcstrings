    "Let %@ find you again. You won't be friends until one of you adds the other." : {
      "comment" : "Party message shown when something goes wrong or as a status line.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann dich wieder finden. Freunde seid ihr erst, wenn einer den anderen hinzufügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que %@ te encuentre de nuevo. No seréis amigos hasta que uno añada al otro."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayaang makita ka ulit ni %@. Hindi kayo magkaibigan hangga't walang nag-a-add."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pourra te retrouver. Vous serez amis seulement si l'un ajoute l'autre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が再びあなたを見つけられるようにします。どちらかが追加するまでフレンドにはなりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 다시 나를 찾을 수 있어요. 둘 중 한 명이 추가해야 친구가 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe %@ te achar de novo. Vocês só serão amigos quando um adicionar o outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ снова сможет тебя найти. Друзьями вы станете, когда кто-то добавит другого."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 %@ 能再次找到你。你们需要有一方重新添加才会成为好友。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓 %@ 能再找到你。要等其中一方加對方，你們才會成為好友。"
          }
        }
      }
    },
