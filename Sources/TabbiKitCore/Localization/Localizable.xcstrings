    "Switching keeps your other settings, and you can undo it under Kit in Settings." : {
      "comment" : "Shown in KitImportReviewView.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine anderen Einstellungen bleiben, und du kannst den Wechsel unter Kit in den Einstellungen rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar conserva tus demás ajustes, y puedes deshacerlo en Kit, en Ajustes."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi magbabago ang iba mong settings, at puwede mo itong i-undo sa Kit sa Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes autres réglages sont conservés, et tu peux annuler sous Kit dans les Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り替えてもほかの設定はそのままです。設定の「キット」で元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바꿔도 다른 설정은 그대로이고, 설정의 키트에서 되돌릴 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trocar mantém seus outros ajustes, e você pode desfazer em Kit, nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остальные настройки сохранятся, а отменить смену можно в разделе «Набор» в настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换会保留你的其他设置，也可以在设置的“套件”中撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換後其他設定都會保留，也能在設定的「套件」中復原。"
          }
        }
