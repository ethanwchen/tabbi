    "Blend up to three, or pick none for silence. Made on your Mac; fades in with focus and out at your break." : {
      "comment" : "Focus sound section footer.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mische bis zu drei oder wähle keinen für Stille. Auf deinem Mac erzeugt; blendet mit dem Fokus ein und zur Pause aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezcla hasta tres o no elijas ninguno para silencio. Se genera en tu Mac; sube al empezar el enfoque y baja en el descanso."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagsamahin ang hanggang tatlo, o walang piliin para tahimik. Gawa sa Mac mo; lalakas sa focus at hihina sa break."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mélange jusqu'à trois sons, ou aucun pour le silence. Créé sur ton Mac ; monte avec le focus et s'efface à la pause."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大3つまで重ねられます。何も選ばなければ無音です。Mac上で生成し、集中の開始でフェードイン、休憩でフェードアウトします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 3개까지 섞거나, 아무것도 고르지 않으면 무음입니다. Mac에서 만들어지며 집중할 때 커지고 휴식할 때 줄어듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misture até três, ou nenhum para silêncio. Gerado no seu Mac; aumenta com o foco e some na pausa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До трёх звуков или тишина. Звук создаётся на твоём Mac, нарастает с фокусом и затихает в перерыв."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多混合三种，不选则保持安静。在你的 Mac 上生成，专注时淡入，休息时淡出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多混合三種，不選則保持安靜。在你的 Mac 上產生，專注時淡入，休息時淡出。"
          }
        }
      }
    },
