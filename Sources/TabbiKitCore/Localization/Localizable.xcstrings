    "Spread your open tasks and reviews over the week's free time. Planned on this Mac, nothing is added until you say so" : {
      "comment" : "Schedule panel: tooltip of Plan in the week view.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verteile offene Aufgaben und Wiederholungen auf die freie Zeit der Woche. Auf diesem Mac geplant, nichts wird ohne dich eingetragen"
          }
        },
        "es" : {
          "stringUnit" : {
