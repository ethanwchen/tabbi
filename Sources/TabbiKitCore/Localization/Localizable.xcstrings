    },
    "In Shortcuts, click the + button and name the new shortcut:" : {
      "comment" : "Setup walkthrough or permission priming sheet in Settings > Connections.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke in Kurzbefehle auf die Taste + und nenne den neuen Kurzbefehl:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Atajos, haz clic en el botón + y ponle este nombre al nuevo atajo:"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa Shortcuts, i-click ang + button at pangalanan ang bagong shortcut:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Raccourcis, clique sur le bouton + et nomme le nouveau raccourci :"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットで「+」ボタンをクリックし、新しいショートカットに次の名前を付けます："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축어에서 + 버튼을 클릭하고 새 단축어 이름을 다음과 같이 지정하세요:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Atalhos, clique no botão + e dê este nome ao novo atalho:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В «Быстрых командах» нажми кнопку + и назови новую команду так:"
