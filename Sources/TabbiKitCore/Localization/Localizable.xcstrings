    "Next, your Mac asks if Tabbi can control %@. Click Allow." : {
      "comment" : "Setup walkthrough or permission priming sheet in Settings > Connections.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleich fragt dein Mac, ob Tabbi %@ steuern darf. Klicke auf Erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora tu Mac preguntará si Tabbi puede controlar %@. Haz clic en Permitir."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Susunod, tatanungin ng Mac mo kung puwedeng kontrolin ng Tabbi ang %@. I-click ang Allow."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac va demander si Tabbi peut contrôler %@. Clique sur Autoriser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に、Tabbiが %@ を操作してよいかMacが確認します。「許可」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 Mac이 Tabbi의 %@ 제어를 허용할지 물어봐요. '허용'을 클릭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora seu Mac vai perguntar se o Tabbi pode controlar o %@. Clique em Permitir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас Mac спросит, можно ли Tabbi управлять %@. Нажми «Разрешить»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来，Mac 会询问是否允许 Tabbi 控制 %@。请点按“允许”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下來，Mac 會詢問是否允許 Tabbi 控制 %@。請按一下「允許」。"
          }
        }
      }
    },
