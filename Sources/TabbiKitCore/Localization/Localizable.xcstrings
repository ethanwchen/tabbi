    "Claude only sees your events when you ask it to plan your day." : {
      "comment" : "Setup walkthrough or permission priming sheet in Settings > Connections.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude sieht deine Termine nur, wenn du es deinen Tag planen lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude solo ve tus eventos cuando le pides que planee tu día."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakikita lang ni Claude ang events mo kapag pinaplano mo sa kanya ang araw mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude ne voit tes événements que si tu lui demandes de planifier ta journée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claudeが予定を見るのは、1日の計画を頼んだときだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude는 하루 계획을 부탁할 때만 일정을 봐요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude só vê seus eventos quando você pede para ele planejar seu dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude видит твои события, только когда ты просишь его спланировать день."
