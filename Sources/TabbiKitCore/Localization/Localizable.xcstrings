            "value" : "En Anki, elige Herramientas › Complementos › Obtener complementos…"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa Anki, piliin ang Tools › Add-ons › Get Add-ons…"
