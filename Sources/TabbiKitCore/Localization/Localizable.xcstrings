    "Your Mac lets apps switch Do Not Disturb only through shortcuts you make. Two small ones do it." : {
      "comment" : "Setup walkthrough or permission priming sheet in Settings > Connections.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac lässt Apps Nicht stören nur über Kurzbefehle schalten, die du erstellst. Zwei kleine reichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac solo deja que las apps cambien No molestar con atajos que tú creas. Bastan dos pequeños."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinahayaan lang ng Mac mo ang apps na magpalit ng Do Not Disturb gamit ang shortcuts na gawa mo. Sapat na ang dalawang maliit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac ne laisse les apps changer Ne pas déranger que via des raccourcis que tu crées. Deux petits suffisent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macでは、アプリがおやすみモードを切り替えるには、自分で作ったショートカットが必要です。小さなショートカットを2つ作れば大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서는 직접 만든 단축어로만 앱이 방해금지 모드를 바꿀 수 있어요. 작은 단축어 두 개면 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Mac só deixa apps mudarem o Não Perturbe por atalhos que você cria. Dois pequenos bastam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac разрешает приложениям переключать «Не беспокоить» только через быстрые команды, которые создаешь ты. Хватит двух простых."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 只允许 App 通过你创建的快捷指令切换勿扰模式。两个简单的快捷指令就够了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 只允許 App 透過你建立的捷徑切換勿擾模式。兩個簡單的捷徑就夠了。"
          }
        }
      }
    },
    "Your Mac's CPU, GPU and memory use at a glance." : {
      "comment" : "One-line summary of the System module in the Settings module library.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
