    "%@ is already used by another app. Record a different shortcut." : {
      "comment" : "Settings > General error; %@ is the shortcut, e.g. Control-Option-Space.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird schon von einer anderen App genutzt. Nimm einen anderen Kurzbefehl auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app ya usa %@. Graba otro atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est déjà utilisé par une autre app. Enregistre un autre raccourci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は別のアプリで使われています。別のショートカットを登録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 키는 다른 앱에서 이미 쓰고 있어요. 다른 단축키를 입력해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já é usado por outro app. Grave um atalho diferente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已被其他 App 占用，请录制其他快捷键。"
          }
        }
      }
    },
    "%@ is damaged, so it's left untouched." : {
      "comment" : "Today panel error detail. %@ is the damaged file's name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
