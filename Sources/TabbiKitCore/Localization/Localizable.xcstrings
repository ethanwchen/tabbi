    "Hide the notch while an app is fullscreen on its display. The shortcut still opens it." : {
      "comment" : "Tooltip for Hide in fullscreen in Settings > General.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
