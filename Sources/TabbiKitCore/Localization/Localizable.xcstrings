    "Accounts are for people %lld and older. Signing in opens in %@." : {
      "comment" : "Account sheet for someone under the minimum age. Arguments: the age (13), a month and year (May 2028). Keep the legal meaning exact.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten gibt es ab %1$lld Jahren. Die Anmeldung ist ab %2$@ möglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas son para personas de %1$lld años o más. Podrás iniciar sesión en %2$@."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para lang sa edad %1$lld pataas ang mga account. Puwede kang mag-sign in simula %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes sont réservés aux personnes de %1$lld ans et plus. La connexion sera possible en %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントは%1$lld歳以上の方が対象です。%2$@からサインインできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정은 만 %1$lld세 이상만 만들 수 있어요. %2$@부터 로그인할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
