    "Pick %@ again to allow it to receive your AI requests. %@ sends nothing until you do." : {
      "comment" : "Settings > Connections footer. Arguments: the provider (Claude API), the app name (Tabbi).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle %1$@ erneut, damit es deine KI-Anfragen erhalten darf. %2$@ sendet nichts, bevor du das tust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a elegir %1$@ para permitir que reciba tus solicitudes de IA. %2$@ no envía nada hasta entonces."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin ulit ang %1$@ para payagan itong tumanggap ng mga AI request mo. Walang ipapadala ang %2$@ hangga't hindi mo ginagawa ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis à nouveau %1$@ pour l'autoriser à recevoir tes demandes d'IA. %2$@ n'envoie rien d'ici là."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIリクエストの受信を許可するには、もう一度%1$@を選んでください。それまで%2$@は何も送信しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 요청을 받도록 허용하려면 %1$@을(를) 다시 고르세요. 그 전까지 %2$@은(는) 아무것도 보내지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha %1$@ de novo para permitir que receba seus pedidos de IA. O %2$@ não envia nada até lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери %1$@ снова, чтобы разрешить отправку твоих запросов к ИИ. До этого %2$@ ничего не отправляет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次选择 %1$@ 以允许它接收你的 AI 请求。在此之前 %2$@ 不会发送任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次選擇 %1$@，允許它接收你的 AI 請求。在此之前，%2$@ 不會傳送任何內容。"
          }
        }
      }
    },
