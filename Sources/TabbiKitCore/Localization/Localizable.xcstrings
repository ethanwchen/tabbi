    "The Anki tab shows your due cards, top decks and streak, and Today counts your reviews toward the day." : {
      "comment" : "Shown in AnkiConnectSetupView.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anki-Tab zeigt deine fälligen Karten, Top-Stapel und deine Serie, und Heute zählt deine Wiederholungen zum Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pestaña Anki muestra tus tarjetas pendientes, tus mazos principales y tu racha, y Hoy suma tus repasos al día."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipinapakita ng Anki tab ang mga due card mo, top decks at streak, at binibilang ng Ngayon ang reviews mo para sa araw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'onglet Anki montre tes cartes à revoir, tes paquets principaux et ta série, et Aujourd'hui compte tes révisions dans ta journée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ankiタブには期限のカード、主なデッキ、連続記録が表示され、今日の画面で復習数がその日の分に加算されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anki 탭에는 복습할 카드, 주요 덱, 연속 기록이 보이고, 오늘 탭에서 복습이 하루 기록에 더해져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aba Anki mostra seus cards pendentes, seus principais baralhos e sua sequência, e Hoje conta suas revisões no dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкладка Anki показывает карточки к повторению, главные колоды и серию, а Сегодня засчитывает повторения в твой день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anki 标签页显示待复习的卡片、常用牌组和连续记录，“今天”会把你的复习计入当天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anki 標籤頁會顯示待複習的卡片、常用牌組和連續紀錄，「今天」會把你的複習算進當天。"
          }
        }
      }
    },
