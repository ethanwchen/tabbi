            "state" : "translated",
            "value" : "Klicke in Internetaccounts auf Account hinzufügen, dann auf Google, und melde dich an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Cuentas de internet, haz clic en Añadir cuenta, luego en Google, e inicia sesión."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa Internet Accounts, i-click ang Add Account, tapos Google, at mag-sign in."
          }
