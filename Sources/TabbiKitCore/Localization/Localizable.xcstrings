        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para adjuntar tu pantalla, activa Tabbi en Grabación de pantalla. La captura solo va a %@ con tu pregunta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para i-attach ang screen mo, i-on ang Tabbi sa Screen Recording. Kay %@ lang mapupunta ang screenshot kasama ng tanong mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour joindre ton écran, active Tabbi dans Enregistrement de l'écran. La capture va seulement à %@ avec ta question."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面を添付するには、画面収録でTabbiをオンにしてください。スクリーンショットは質問と一緒に%@にだけ送られます。"
