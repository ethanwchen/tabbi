          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Системных настройках включи %@ под Tabbi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在系统设置中，打开 Tabbi 下的 %@。"
