        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視差効果を減らす」がオンのため、動く代わりにフェードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동작 줄이기가 켜져 있어서 움직이는 대신 서서히 바뀌어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduzir Movimento está ativado, então as mudanças esmaecem em vez de se mover."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
