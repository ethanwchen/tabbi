{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ Themes style the open panel; the closed notch stays black." : {
      "comment" : "Footer in Settings > Look; %@ is the selected theme's one-sentence summary.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Designs gestalten das offene Panel, die geschlossene Notch bleibt schwarz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Los temas cambian el panel abierto; el notch cerrado sigue negro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Les thèmes habillent le panneau ouvert ; l'encoche fermée reste noire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ テーマは開いたパネルに適用され、閉じたノッチは黒のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 테마는 열린 패널에 적용되고, 닫힌 노치는 검은색 그대로예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Os temas mudam o painel aberto; o notch fechado continua preto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 主题会改变展开的面板，收起的刘海保持黑色。"
          }
        }
      }
    },
    "%@ is already used by another app. Record a different shortcut." : {
      "comment" : "Settings > General error; %@ is the shortcut, e.g. Control-Option-Space.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird schon von einer anderen App genutzt. Nimm einen anderen Kurzbefehl auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app ya usa %@. Graba otro atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est déjà utilisé par une autre app. Enregistre un autre raccourci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は別のアプリで使われています。別のショートカットを登録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 키는 다른 앱에서 이미 쓰고 있어요. 다른 단축키를 입력해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já é usado por outro app. Grave um atalho diferente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已被其他 App 占用，请录制其他快捷键。"
          }
        }
      }
    },
    "%@ moved to position %lld of %lld" : {
      "comment" : "VoiceOver announcement after reordering a tab; %@ is the tab name, then its new position and the tab count.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist jetzt an Position %2$lld von %3$lld"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ se movió a la posición %2$lld de %3$lld"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ déplacé en position %2$lld sur %3$lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@を%3$lld個中%2$lld番目に移動しました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 탭을 %3$lld개 중 %2$lld번째로 옮겼어요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ foi para a posição %2$lld de %3$lld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已移到第 %2$lld 位，共 %3$lld 个"
          }
        }
      }
    },
