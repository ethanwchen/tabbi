    "Anki needs a free add-on called AnkiConnect so Tabbi can count your cards." : {
      "comment" : "Connection status line in Settings > Connections (Anki). %@ is an app or connection name, %lld a number.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anki braucht das kostenlose Add-on AnkiConnect, damit Tabbi deine Karten zählen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anki necesita un complemento gratis llamado AnkiConnect para que Tabbi cuente tus tarjetas."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kailangan ng Anki ng libreng add-on na AnkiConnect para mabilang ng Tabbi ang mga card mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anki a besoin d'un module gratuit, AnkiConnect, pour que Tabbi compte tes cartes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TabbiがカードをカウントするにはAnkiConnectという無料アドオンが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabbi가 카드를 셀 수 있으려면 Anki에 무료 애드온 AnkiConnect가 필요해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Anki precisa de um complemento gratuito chamado AnkiConnect para o Tabbi contar seus cartões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anki нужен бесплатный аддон AnkiConnect, чтобы Tabbi мог считать карточки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anki 需要一个免费插件 AnkiConnect，Tabbi 才能统计你的卡片。"
          }
        },
        "zh-Hant" : {
