    "It's an AI helper that can plan your day and answer questions. Everything else works without it." : {
      "comment" : "Connection status line in Settings > Connections (Claude). %@ is an app or connection name, %lld a number.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein KI-Helfer, der deinen Tag plant und Fragen beantwortet. Alles andere geht auch ohne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un asistente de IA que puede planear tu día y responder preguntas. Todo lo demás funciona sin él."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI helper ito na kayang magplano ng araw mo at sumagot sa mga tanong. Gumagana ang lahat ng iba kahit wala ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est un assistant IA qui peut planifier ta journée et répondre à tes questions. Tout le reste marche sans lui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
