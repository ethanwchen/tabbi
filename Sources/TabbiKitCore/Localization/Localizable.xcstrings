    "%@ Themes style the open panel; the closed notch stays black." : {
      "comment" : "Footer in Settings > Look; %@ is the selected theme's one-sentence summary.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Designs gestalten das offene Panel, die geschlossene Notch bleibt schwarz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Los temas cambian el panel abierto; el notch cerrado sigue negro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Les thèmes habillent le panneau ouvert ; l'encoche fermée reste noire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ テーマは開いたパネルに適用され、閉じたノッチは黒のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 테마는 열린 패널에 적용되고, 닫힌 노치는 검은색 그대로예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Os temas mudam o painel aberto; o notch fechado continua preto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 主题会改变展开的面板，收起的刘海保持黑色。"
          }
        }
      }
    },
    "%@ can't control %@" : {
      "comment" : "Now Playing title when macOS Automation permission is denied. First %@ is this app's name (Tabbi), second the music app name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kann %2$@ nicht steuern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no puede controlar %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne peut pas contrôler %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%2$@を操作できません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 %2$@을(를) 제어할 수 없어요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %1$@ não consegue controlar o %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 无法控制 %2$@"
          }
        }
      }
    },
    "%@ done for today. Open %@" : {
      "comment" : "Tooltip of a finished shared row on Today. First %@ is the item (e.g. 'Anki reviews'), second the module's name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ für heute erledigt. %2$@ öffnen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hecho por hoy. Abrir %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fait pour aujourd'hui. Ouvrir %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は今日は完了。%2$@を開く"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 오늘 완료. %2$@ 열기"
