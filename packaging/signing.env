# Release signing settings, read by scripts/release.sh. Environment variables
# with the same names override these values.
#
# DEVELOPER_ID: the codesigning identity. Leave it empty to use the single
# "Developer ID Application: <Name> (<TEAMID>)" identity in your keychain
# (security find-identity -v -p codesigning lists them). Set it when you have
# more than one, for example:
#   DEVELOPER_ID="Developer ID Application: Jane Doe (ABCDE12345)"
DEVELOPER_ID=

# NOTARY_PROFILE: the notarytool keychain profile, created once with
#   xcrun notarytool store-credentials notchdeck
# The name predates the rename to Tabbi and is kept so stored credentials keep working.
NOTARY_PROFILE=notchdeck
