<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tabbi.entitlements plus Sign in with Apple, for Developer ID releases that
  embed packaging/Tabbi.provisionprofile (see docs/sync.md). scripts/release.sh
  uses this file only when that profile exists, and checks that its team and
  application identifier match the two keys below. Keep the first three keys
  in step with Tabbi.entitlements.
  - applesignin: the optional account that syncs the pet across Macs.
  - application-identifier and team-identifier: macOS only honors a restricted
    entitlement when they match the embedded profile.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>B9VRALHV8S.dev.tabbi.Tabbi</string>
    </array>
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
    <key>com.apple.application-identifier</key>
    <string>B9VRALHV8S.dev.tabbi.Tabbi</string>
    <key>com.apple.developer.team-identifier</key>
    <string>B9VRALHV8S</string>
</dict>
</plist>
