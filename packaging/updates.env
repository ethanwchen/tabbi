# Update settings, read by scripts/release.sh, which writes them into the
# release app's Info.plist. Development builds carry neither, so they never
# update themselves. Environment variables with the same names override these.
#
# SPARKLE_PUBLIC_KEY: the EdDSA public key that every update must be signed
# with. Not a secret. Create the key pair once (the private key stays in your
# login keychain; never commit it) and paste the printed public key here:
#   .build/artifacts/sparkle/Sparkle/bin/generate_keys
# Until it is set, Developer ID releases stop and ad-hoc builds ship with
# updates turned off.
# The release script signs the appcast with the private key from the
# keychain, or from the SPARKLE_PRIVATE_KEY environment variable (a CI
# secret holding what generate_keys -x exported). Never put it in this file.
SPARKLE_PUBLIC_KEY=

# SPARKLE_FEED_URL: the appcast the app checks, HTTPS only. Each release
# uploads appcast.xml as a GitHub Release asset, so "latest" always points at
# the newest one.
SPARKLE_FEED_URL=https://github.com/ethanwchen/tabbi/releases/latest/download/appcast.xml
