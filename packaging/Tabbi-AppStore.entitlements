<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Sandbox entitlements for the Mac App Store build of Tabbi
  (scripts/release-appstore.sh, docs/appstore.md). The direct download uses
  Tabbi.entitlements instead and is not sandboxed.
  - app-sandbox: required for every Mac App Store app.
  - network.client: album artwork, AnkiConnect on localhost, the AI
    provider the user picks for Ask AI, Plan my day and Wrap up (Anthropic,
    OpenAI or Gemini with the user's key, or Ollama on localhost), the
    friends server behind Party and sync, and crash reports the user chose
    to send.
  - personal-information.calendars: Today and Plan my day use EventKit.
  - files.user-selected.read-only: Import a Kit and the pet coach's
    distracting apps read files the user picks in an open panel, and AI
    Usage reads the Claude Code or Codex folder the user picks.
  - files.bookmarks.app-scope: AI Usage keeps that folder as a
    security-scoped bookmark, so the user picks it once, not every launch.
  - application-groups: the container the app shares with the desktop widget
    (docs/widget.md).
  - temporary-exception.apple-events: Now Playing scripts Spotify and Music,
    which a sandboxed app may only send Apple Events to when listed here.
  - scripting-targets: Do Not Disturb during focus runs the user's two
    shortcuts through Shortcuts Events, whose scripting definition puts
    running shortcuts in the com.apple.shortcuts.run access group.
  - applesignin: the optional account that syncs the pet across Macs
    (docs/sync.md). The App Store profile must grant it.
  release-appstore.sh adds the application and team identifiers from the
  provisioning profile when it signs for the App Store; an ad-hoc build
  (its adhoc option) leaves them and applesignin out, since macOS refuses
  to launch an app that claims them without a matching profile.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>B9VRALHV8S.dev.tabbi.Tabbi</string>
    </array>
    <key>com.apple.security.temporary-exception.apple-events</key>
    <array>
        <string>com.spotify.client</string>
        <string>com.apple.Music</string>
    </array>
    <key>com.apple.security.scripting-targets</key>
    <dict>
        <key>com.apple.shortcuts.events</key>
        <array>
            <string>com.apple.shortcuts.run</string>
        </array>
    </dict>
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
</dict>
</plist>
