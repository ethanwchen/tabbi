        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique sur le bouton ci-dessous. Il copie la ligne d'installation et ouvre PowerShell, inclus dans Windows."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下のボタンをクリックすると、セットアップ用のコマンドがコピーされ、Windowsに付属のPowerShellが開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 버튼을 클릭하면 설정 명령어가 복사되고 Windows에 들어 있는 PowerShell이 열려요."
