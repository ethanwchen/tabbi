    "Click in the PowerShell window, press Ctrl+V to paste, then press Enter." : {
      "comment" : "Settings > Connections: a step of the Claude walkthroughs on Windows. Name the keys as the language's Windows keyboards label them.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر في نافذة PowerShell، واضغط Ctrl+V للصق، ثم اضغط Enter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke ins PowerShell-Fenster, drücke Strg+V zum Einfügen und dann die Eingabetaste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en la ventana de PowerShell, pulsa Ctrl+V para pegar y luego pulsa Intro."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-click sa PowerShell window, pindutin ang Ctrl+V para mag-paste, tapos pindutin ang Enter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique dans la fenêtre PowerShell, appuie sur Ctrl+V pour coller, puis sur Entrée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerShellのウインドウ内をクリックし、Ctrl+Vで貼り付けてから、Enterキーを押します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerShell 창을 클릭하고 Ctrl+V를 눌러 붙여넣은 다음 Enter 키를 누르세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
