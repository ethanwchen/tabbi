          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это не ссылка на календарь. Скопируй адрес iCal или ICS в настройках своего календаря."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
