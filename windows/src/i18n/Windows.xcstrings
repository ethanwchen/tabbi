          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅은 이 PC의 %@ 폴더에만 저장돼요. AI에게 묻기 탭의 기록에서 삭제할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
