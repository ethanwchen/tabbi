          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no. Copia el enlace de tu calendario desde Google, Outlook o iCloud."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
