    "Not yet. Copy your calendar's link from Google, Outlook or iCloud." : {
      "comment" : "Settings > Connections > Something not working?: the answer when no calendar link was added.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس بعد. انسخ رابط تقويمك من Google أو Outlook أو iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
