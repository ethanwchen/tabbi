    "Notifications are off for every app. Turn them on in Windows Settings." : {
      "comment" : "Settings > Connections: the Alerts row when notifications are off for all apps. Name Windows Settings as Windows does.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
