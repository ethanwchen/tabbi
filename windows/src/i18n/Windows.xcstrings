    "%@ isn't on this PC yet. Connections shows you how to add it." : {
      "comment" : "Ask AI setup sentence on Windows; %@ is the provider name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ غير موجود على هذا الكمبيوتر بعد. تشرح لك الاتصالات كيفية إضافته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist noch nicht auf diesem PC. Verbindungen zeigt dir, wie es geht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún no está en este PC. Conexiones te enseña a añadirlo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala pa ang %@ sa PC na ito. Ipapakita ng Connections kung paano ito idagdag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est pas encore sur ce PC. Connexions t'explique comment l'ajouter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はまだこの PC にありません。追加方法は「接続」で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC에 아직 %@가 없어요. 연결에서 추가하는 방법을 알려 드려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ ainda não está neste PC. Conexões mostra como adicionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ еще нет на этом ПК. В разделе «Подключения» показано, как добавить."
