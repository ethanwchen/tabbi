          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотри, что меняет этот набор, прежде чем перейти на него."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
