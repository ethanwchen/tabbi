    "Paste a key in Connections to ask %@ questions. It stays in Windows Credential Manager." : {
      "comment" : "Ask AI setup sentence on Windows; %@ is the assistant name. Credential Manager is named as Windows names it in each language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصق مفتاحًا في الاتصالات لتسأل %@. يبقى في مدير بيانات اعتماد Windows."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge in Verbindungen einen Schlüssel ein, um %@ zu fragen. Er bleibt in der Windows-Anmeldeinformationsverwaltung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega una clave en Conexiones para preguntar a %@. Se queda en el Administrador de credenciales de Windows."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-paste ng key sa Connections para makapagtanong kay %@. Mananatili ito sa Windows Credential Manager."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colle une clé dans Connexions pour interroger %@. Elle reste dans le Gestionnaire d'identification Windows."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「接続」にキーを貼り付けると %@ に質問できます。キーは Windows 資格情報マネージャーに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결에 키를 붙여 넣으면 %@에게 질문할 수 있어요. 키는 Windows 자격 증명 관리자에 보관돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole uma chave em Conexões para perguntar ao %@. Ela fica no Gerenciador de Credenciais do Windows."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставь ключ в подключениях, чтобы задавать вопросы %@. Он хранится в Диспетчере учетных данных Windows."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“连接”中粘贴密钥即可向 %@ 提问。密钥保存在 Windows 凭据管理器中。"
