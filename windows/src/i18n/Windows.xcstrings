    "This tab arrives in a later Windows build." : {
      "comment" : "A tab's placeholder on Windows when its module is not ported yet. Use the same word for tab as the tab bar does.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل علامة التبويب هذه في إصدار لاحق لنظام Windows."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tab kommt in einer späteren Windows-Version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pestaña llega en una versión posterior para Windows."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darating ang tab na ito sa susunod na Windows build."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet onglet arrive dans une prochaine version Windows."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタブは今後のWindows版で使えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 탭은 이후 Windows 버전에서 제공돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aba chega em uma versão futura para Windows."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта вкладка появится в одной из следующих версий для Windows."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此标签页将在之后的 Windows 版本中推出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此標籤頁將在之後的 Windows 版本推出。"
          }
        }
      }
    },
    "Your PC is charging, and %@ is having a sip" : {
      "comment" : "Closed island tooltip on Windows while the pet sips because the PC started charging; %@ is the pet's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهاز الكمبيوتر يُشحن، و%@ يرتشف رشفة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein PC lädt, und %@ nimmt einen Schluck"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu PC se está cargando y %@ toma un sorbito"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagcha-charge ang PC mo, at umiinom si %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton PC charge, et %@ boit une gorgée"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PCを充電中、%@もひと休みで一口"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC가 충전 중이고, %@도 한 모금 마시는 중"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu PC está carregando, e %@ está tomando um golinho"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ПК заряжается, а %@ немного попьет"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电脑正在充电，%@ 也在喝一小口"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電腦正在充電，%@ 也在喝一小口"
