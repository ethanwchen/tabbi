    "%@ Fix it in Settings > Tabs > Party > Options." : {
      "comment" : "Onboarding's party step: the server setting can't be used. %@ is the problem sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ أصلحه من الإعدادات > التبويبات > Party > الخيارات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Behebe das unter Einstellungen > Tabs > Party > Optionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Arréglalo en Ajustes > Pestañas > Party > Opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Corrige-le dans Réglages > Onglets > Party > Options."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ayusin ito sa Settings > Tabs > Party > Options."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 設定 > タブ > Party > オプションで修正してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 설정 > 탭 > Party > 옵션에서 고쳐 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Corrija em Ajustes > Abas > Party > Opções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Исправь это в Настройках > Вкладки > Party > Параметры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请在设置 > 标签页 > Party > 选项中修正。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 請在設定 > 分頁 > Party > 選項中修正。"
          }
        }
      }
    },
    "%@ Themes style the open panel; the closed pill stays black." : {
      "comment" : "Settings > Look: footer under the themes. %@ is the chosen theme's summary sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ تنسّق السمات اللوحة المفتوحة؛ تبقى الكبسولة المغلقة سوداء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Themes gestalten das offene Panel; die geschlossene Pille bleibt schwarz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Los temas dan estilo al panel abierto; la píldora cerrada sigue negra."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ang mga theme ang nagbibigay-istilo sa bukas na panel; nananatiling itim ang nakasarang pill."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Les thèmes habillent le panneau ouvert ; la pilule fermée reste noire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ テーマは開いたパネルの見た目を変えます。閉じたピルは黒のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 테마는 열린 패널의 모습을 바꿔요. 닫힌 알약 모양 바는 검은색 그대로예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Os temas estilizam o painel aberto; a pílula fechada continua preta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Темы оформляют открытую панель; закрытая капсула остаётся чёрной."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 主题只装饰打开的面板；收起的胶囊保持黑色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 主題只裝飾開啟的面板；收合的膠囊保持黑色。"
          }
        }
      }
    },
