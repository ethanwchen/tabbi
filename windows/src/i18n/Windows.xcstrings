    "Turn it on yourself while you focus." : {
      "comment" : "Settings > Connections: the Do not disturb row's line on Windows, where apps can't switch it; the user turns it on.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّله بنفسك أثناء التركيز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte es beim Fokussieren selbst ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalo tú mientras te concentras."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-on mo ito habang nagfo-focus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active-le toi-même pendant ta concentration."
          }
        },
        "ja" : {
