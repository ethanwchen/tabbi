    "Click in the PowerShell window, press Ctrl+V to paste, then press Enter." : {
      "comment" : "Settings > Connections: a step of the Claude walkthroughs on Windows. Name the keys as the language's Windows keyboards label them.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر في نافذة PowerShell، واضغط Ctrl+V للصق، ثم اضغط Enter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke ins PowerShell-Fenster, drücke Strg+V zum Einfügen und dann die Eingabetaste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en la ventana de PowerShell, pulsa Ctrl+V para pegar y luego pulsa Intro."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-click sa PowerShell window, pindutin ang Ctrl+V para mag-paste, tapos pindutin ang Enter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique dans la fenêtre PowerShell, appuie sur Ctrl+V pour coller, puis sur Entrée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerShellのウインドウ内をクリックし、Ctrl+Vで貼り付けてから、Enterキーを押します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerShell 창을 클릭하고 Ctrl+V를 눌러 붙여넣은 다음 Enter 키를 누르세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique na janela do PowerShell, pressione Ctrl+V para colar e depois Enter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щелкни в окне PowerShell, нажми Ctrl+V, чтобы вставить, затем нажми Enter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击 PowerShell 窗口，按 Ctrl+V 粘贴，然后按 Enter 键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下 PowerShell 視窗，按 Ctrl+V 貼上，再按 Enter 鍵。"
          }
        }
      }
    },
    "Click the button below. It copies the setup line and opens PowerShell, which comes with Windows." : {
      "comment" : "Settings > Connections: a step of the Set up Claude walkthrough on Windows. PowerShell is an app name; keep it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر الزر أدناه. ينسخ سطر الإعداد ويفتح PowerShell، الذي يأتي مع Windows."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf die Taste unten. Sie kopiert die Einrichtungszeile und öffnet PowerShell, das bei Windows dabei ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en el botón de abajo. Copia la línea de configuración y abre PowerShell, que viene con Windows."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-click ang button sa ibaba. Kinokopya nito ang setup line at binubuksan ang PowerShell, na kasama ng Windows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique sur le bouton ci-dessous. Il copie la ligne d'installation et ouvre PowerShell, inclus dans Windows."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下のボタンをクリックすると、セットアップ用のコマンドがコピーされ、Windowsに付属のPowerShellが開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 버튼을 클릭하면 설정 명령어가 복사되고 Windows에 들어 있는 PowerShell이 열려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique no botão abaixo. Ele copia a linha de configuração e abre o PowerShell, que vem com o Windows."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми кнопку ниже. Она скопирует команду установки и откроет PowerShell, который есть в Windows."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击下方按钮。它会复制安装命令并打开 Windows 自带的 PowerShell。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下下方按鈕。它會拷貝安裝指令並打開 Windows 內建的 PowerShell。"
          }
        }
      }
    },
