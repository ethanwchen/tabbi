        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캘린더 링크가 아니에요. 캘린더 설정에서 iCal 또는 ICS 주소를 복사하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
