    },
    "Nothing is drawn until the pointer rests at the top center or you press the shortcut." : {
      "comment" : "Settings > Look: caption for the Only on hover or hotkey mode.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُرسم شيء حتى يستقر المؤشر في أعلى المنتصف أو تضغط الاختصار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wird gezeichnet, bis der Zeiger oben in der Mitte ruht oder du den Kurzbefehl drückst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se muestra nada hasta que el puntero se detiene en el centro superior o pulsas el atajo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang ipapakita hangga't hindi tumitigil ang pointer sa gitnang itaas o pinipindot mo ang shortcut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'apparaît tant que le pointeur ne s'arrête pas en haut au centre ou que tu n'appuies pas sur le raccourci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインターが上部中央で止まるかショートカットを押すまで何も表示しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포인터가 위쪽 가운데에 머무르거나 단축키를 누르기 전까지는 아무것도 보이지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada aparece até o ponteiro parar no centro superior ou você apertar o atalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не отображается, пока указатель не задержится вверху по центру или ты не нажмёшь сочетание клавиш."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在指针停在顶部中央或按下快捷键之前不显示任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在指標停在頂端中央或按下快速鍵之前不顯示任何內容。"
          }
        }
      }
    },
    "Nothing is sent in this build yet. When crash reports arrive, they go only with your say-so and never hold typed text, names or file paths." : {
      "comment" : "Settings > About: footer under the crash reports row on Windows, where no report is sent yet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُرسل شيء في هذا الإصدار بعد. عندما تتوفر تقارير الأعطال، ستُرسل فقط بموافقتك ولن تحتوي أبدًا على نص مكتوب أو أسماء أو مسارات ملفات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Build wird noch nichts gesendet. Wenn Absturzberichte kommen, gehen sie nur mit deinem Einverständnis raus und enthalten nie getippten Text, Namen oder Dateipfade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión aún no envía nada. Cuando lleguen los informes de fallos, solo se enviarán con tu permiso y nunca incluirán texto escrito, nombres ni rutas de archivos."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala pang ipinapadala sa build na ito. Kapag dumating na ang mga crash report, ipapadala lang ito nang may pahintulot mo at hindi kailanman maglalaman ng na-type na text, pangalan o file path."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version n'envoie encore rien. Quand les rapports de plantage arriveront, ils ne partiront qu'avec ton accord et ne contiendront jamais de texte saisi, de noms ni de chemins de fichiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドではまだ何も送信しません。クラッシュレポートが導入されても、あなたの同意がある場合だけ送られ、入力した文字、名前、ファイルパスは決して含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 빌드에서는 아직 아무것도 보내지 않아요. 충돌 보고서가 생기더라도 당신의 동의가 있을 때만 보내고, 입력한 글, 이름, 파일 경로는 절대 담지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão ainda não envia nada. Quando os relatórios de falhas chegarem, só vão com a sua permissão e nunca terão texto digitado, nomes ou caminhos de arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой сборке пока ничего не отправляется. Когда появятся отчёты о сбоях, они будут уходить только с твоего согласия и никогда не будут содержать набранный текст, имена или пути к файлам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本尚不发送任何内容。崩溃报告上线后，也只会在你同意时发送，且绝不包含输入的文字、姓名或文件路径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本尚未傳送任何內容。當機報告上線後，也只會在你同意時傳送，且絕不包含輸入的文字、姓名或檔案路徑。"
          }
        }
      }
    },
    "Notifications are off for every app. Turn them on in Windows Settings." : {
      "comment" : "Settings > Connections: the Alerts row when notifications are off for all apps. Name Windows Settings as Windows does.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشعارات متوقفة لكل التطبيقات. شغّلها في إعدادات Windows."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigungen sind für alle Apps aus. Schalte sie in den Windows-Einstellungen ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones están desactivadas para todas las apps. Actívalas en Configuración de Windows."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-off ang notifications para sa lahat ng app. I-on ito sa Windows Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées pour toutes les apps. Active-les dans Paramètres Windows."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのアプリの通知がオフです。Windowsの設定でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 앱의 알림이 꺼져 있어요. Windows 설정에서 켜 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações estão desativadas para todos os apps. Ative nas Configurações do Windows."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления выключены для всех приложений. Включи их в Параметрах Windows."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有应用的通知都已关闭。请在 Windows 设置中打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 App 的通知都已關閉。請在 Windows 設定中開啟。"
          }
        }
      }
    },
    "Off until you turn it on. Settings > General has the switch too." : {
      "comment" : "Onboarding footer hint on the Start with Windows step.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقف حتى تشغّله. المفتاح موجود أيضًا في الإعدادات > عام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus, bis du es einschaltest. Der Schalter ist auch in Einstellungen > Allgemein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado hasta que lo actives. El interruptor también está en Ajustes > General."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-off hangga't hindi mo ino-on. Nasa Settings > General din ang switch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé tant que tu ne l'actives pas. L'interrupteur est aussi dans Réglages > Général."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにするまでオフのままです。設定 > 一般にもスイッチがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜기 전까지는 꺼져 있어요. 설정 > 일반에도 스위치가 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado até você ligar. O botão também está em Ajustes > Geral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключено, пока ты не включишь. Переключатель есть и в Настройках > Основные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
