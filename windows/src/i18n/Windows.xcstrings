          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇開啟面板的大小。所有分頁使用相同的大小。"
          }
        }
      }
    },
    "Choose when the pill is drawn. The shortcut always opens the island." : {
      "comment" : "Settings > Look: tooltip on the Closed island picker.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر متى تُرسم الكبسولة. يفتح الاختصار الجزيرة دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wann die Pille gezeichnet wird. Der Kurzbefehl öffnet die Insel immer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuándo se muestra la píldora. El atajo siempre abre la isla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung kailan ipapakita ang pill. Laging binubuksan ng shortcut ang island."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis quand la pilule apparaît. Le raccourci ouvre toujours l'îlot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピルをいつ表示するか選びます。ショートカットではいつでもアイランドを開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알약 모양 바를 언제 보여줄지 고르세요. 단축키로는 언제나 아일랜드를 열 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quando a pílula aparece. O atalho sempre abre a ilha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
