    "Buy an extra freeze for %lld points. It protects a missed day once this week's free freeze is used." : {
      "comment" : "Closet > Streak: the Buy freeze button's tooltip when it can be bought.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشترِ تجميدًا إضافيًا مقابل %lld نقطة. يحمي يومًا فائتًا بعد استخدام التجميد المجاني لهذا الأسبوع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein zusätzliches Einfrieren für %lld Punkte kaufen. Es schützt einen verpassten Tag, sobald das kostenlose dieser Woche verbraucht ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra una congelación extra por %lld puntos. Protege un día perdido cuando ya usaste la gratuita de esta semana."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bumili ng extra freeze sa %lld puntos. Pinoprotektahan nito ang isang na-miss na araw kapag nagamit na ang libreng freeze ngayong linggo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acheter un gel supplémentaire pour %lld points. Il protège un jour manqué une fois le gel gratuit de la semaine utilisé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lldポイントで追加のフリーズを買います。今週の無料フリーズを使ったあと、逃した日を1日守ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld점으로 추가 프리즈를 사요. 이번 주 무료 프리즈를 쓰고 나면 놓친 하루를 지켜 줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compre um congelamento extra por %lld pontos. Ele protege um dia perdido depois que o grátis desta semana for usado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Купить дополнительную заморозку за %lld очков. Она сохранит пропущенный день, когда бесплатная на этой неделе уже использована."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 %lld 点购买额外冻结。本周免费冻结用完后，它会保住一个错过的日子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 %lld 點購買額外凍結。本週免費凍結用完後，它會保住一個錯過的日子。"
          }
        }
      }
    },
