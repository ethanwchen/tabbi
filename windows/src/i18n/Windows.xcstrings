    "It belongs to your Apple Account. Delete Account above removes it." : {
      "comment" : "Party options, Your data, while signed in: the data goes with the account row above.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخص حساب Apple الخاص بك. يزيلها «حذف الحساب» أعلاه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie gehören zu deinem Apple-Account. „Account löschen“ oben entfernt sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pertenecen a tu cuenta de Apple. Eliminar cuenta, arriba, los borra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles appartiennent à ton compte Apple. Supprimer le compte, ci-dessus, les efface."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pag-aari ito ng Apple Account mo. Tinatanggal ito ng Delete Account sa itaas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらはApple Accountに属します。上の「アカウントを削除」で削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 계정에 속한 데이터예요. 위의 계정 삭제로 지워져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pertencem à sua Conta Apple. Excluir conta, acima, os remove."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они принадлежат твоему Apple Account. «Удалить аккаунт» выше удалит их."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它属于你的 Apple 账户。上方的“删除账户”会一并删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它屬於你的 Apple 帳號。上方的「刪除帳號」會一併刪除。"
          }
        }
      }
    },
