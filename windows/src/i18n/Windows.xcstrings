    "A %lld min break replaces every %@ break" : {
      "comment" : "Timer tab, Custom lengths: tooltip of the long break card while it is on. %1$lld is minutes, %2$@ an ordinal such as 4th.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استراحة %1$lld د تحل محل كل استراحة %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Pause von %1$lld Min. ersetzt jede %2$@ Pause"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pausa de %1$lld min sustituye cada %2$@ pausa"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapalitan ng %1$lld min na pahinga ang bawat %2$@ pahinga"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une pause de %1$lld min remplace chaque %2$@ pause"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@の休憩が%1$lld分の休憩になります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 휴식은 %1$lld분 휴식으로 바뀌어요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pausa de %1$lld min substitui cada %2$@ pausa"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перерыв %1$lld мин заменяет каждый %2$@ перерыв"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
