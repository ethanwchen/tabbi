          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'캘린더 통합'으로 스크롤해 'iCal 형식의 비공개 주소'를 복사하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
