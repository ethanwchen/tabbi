          }
        }
      }
    },
    "Choose how big the open panel is. Every tab uses the same size." : {
      "comment" : "Settings > Look: tooltip on the Panel size control.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر حجم اللوحة المفتوحة. تستخدم كل علامات التبويب الحجم نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie groß das offene Panel ist. Jeder Tab nutzt dieselbe Größe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el tamaño del panel abierto. Todas las pestañas usan el mismo tamaño."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung gaano kalaki ang bukas na panel. Pare-pareho ang laki ng lahat ng tab."
