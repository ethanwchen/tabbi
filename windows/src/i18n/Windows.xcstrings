    "%@ isn't on this PC yet. Connections shows you how to add it." : {
      "comment" : "Ask AI setup sentence on Windows; %@ is the provider name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ غير موجود على هذا الكمبيوتر بعد. تشرح لك الاتصالات كيفية إضافته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist noch nicht auf diesem PC. Verbindungen zeigt dir, wie es geht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún no está en este PC. Conexiones te enseña a añadirlo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala pa ang %@ sa PC na ito. Ipapakita ng Connections kung paano ito idagdag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est pas encore sur ce PC. Connexions t'explique comment l'ajouter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はまだこの PC にありません。追加方法は「接続」で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC에 아직 %@가 없어요. 연결에서 추가하는 방법을 알려 드려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ ainda não está neste PC. Conexões mostra como adicionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ еще нет на этом ПК. В разделе «Подключения» показано, как добавить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑上还没有 %@。“连接”会告诉你如何添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台電腦上還沒有 %@。「連線」會告訴你如何加入。"
          }
        }
      }
    },
    "A school or work setting may block them. You can check in Windows Settings." : {
      "comment" : "Settings > Connections: the Alerts row when a policy blocks notifications. Name Windows Settings as Windows does.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يحظرها إعداد للمدرسة أو العمل. يمكنك التحقق في إعدادات Windows."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht blockiert eine Schul- oder Arbeitseinstellung sie. Du kannst es in den Windows-Einstellungen prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que un ajuste del centro o del trabajo las bloquee. Puedes revisarlo en Configuración de Windows."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baka hinaharang ito ng setting ng school o trabaho. Puwede mong i-check sa Windows Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un réglage de l'école ou du travail les bloque peut-être. Tu peux vérifier dans Paramètres Windows."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学校や職場の設定でブロックされている可能性があります。Windowsの設定で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "학교나 회사 설정이 막고 있을 수 있어요. Windows 설정에서 확인할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ajuste da escola ou do trabalho pode bloquear. Você pode conferir nas Configurações do Windows."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, их блокирует настройка школы или работы. Это можно проверить в Параметрах Windows."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学校或工作的设置可能阻止了它们。你可以在 Windows 设置中查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "學校或工作的設定可能擋住了它們。你可以在 Windows 設定中查看。"
          }
        }
      }
    },
    "Add your calendar's link from Google, Outlook or iCloud to see its events here." : {
      "comment" : "Settings > Connections: the Calendar row before any calendar link was added.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف رابط تقويمك من Google أو Outlook أو iCloud لترى أحداثه هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den Link deines Kalenders aus Google, Outlook oder iCloud hinzu, um seine Termine hier zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega el enlace de tu calendario de Google, Outlook o iCloud para ver sus eventos aquí."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idagdag ang link ng calendar mo mula sa Google, Outlook o iCloud para makita rito ang mga event nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute le lien de ton calendrier Google, Outlook ou iCloud pour voir ses événements ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google、Outlook、iCloudのカレンダーのリンクを追加すると、その予定がここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google, Outlook, iCloud 캘린더 링크를 추가하면 여기서 일정을 볼 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o link do seu calendário do Google, Outlook ou iCloud para ver os eventos aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь ссылку на календарь из Google, Outlook или iCloud, чтобы видеть события здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 Google、Outlook 或 iCloud 的日历链接，就能在这里看到日程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入 Google、Outlook 或 iCloud 的行事曆連結，就能在這裡看到行程。"
          }
        }
      }
    },
    "Another app is using Ctrl+Alt+Space, so open Tabbi from its icon in the tray." : {
      "comment" : "Shown when the global hotkey cannot be registered because another app owns it. Name the keys as the language's Windows keyboards label them, and the tray as Windows calls the notification area in that language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق آخر يستخدم Ctrl+Alt+Space، لذا افتح Tabbi من أيقونته في منطقة الإعلامات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App nutzt Strg+Alt+Leertaste, öffne Tabbi also über sein Symbol im Infobereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app usa Ctrl+Alt+Espacio, así que abre Tabbi desde su icono en el área de notificación."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May ibang app na gumagamit ng Ctrl+Alt+Space, kaya buksan ang Tabbi mula sa icon nito sa tray."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre app utilise Ctrl+Alt+Espace, alors ouvre Tabbi depuis son icône dans la zone de notification."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+Alt+Spaceは別のアプリで使われています。通知領域のTabbiのアイコンから開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+Alt+Space 키는 다른 앱에서 쓰고 있어요. 알림 영역의 Tabbi 아이콘에서 열어 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro app está usando Ctrl+Alt+Espaço, então abra o Tabbi pelo ícone na área de notificação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+Alt+Пробел занято другим приложением, поэтому открывай Tabbi значком в области уведомлений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+Alt+空格 已被其他 App 占用，请从通知区域中的 Tabbi 图标打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+Alt+空白鍵 已被其他 App 使用。請從通知區域中的 Tabbi 圖示開啟。"
          }
        }
      }
    },
    "Answers come from the AI you pick: Claude, ChatGPT, Gemini or a free model on this PC." : {
      "comment" : "Ask AI setup sentence when no AI provider is picked, on Windows.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي الإجابات من الذكاء الاصطناعي الذي تختاره: Claude أو ChatGPT أو Gemini أو نموذج مجاني على هذا الكمبيوتر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten kommen von der KI deiner Wahl: Claude, ChatGPT, Gemini oder ein kostenloses Modell auf diesem PC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde la IA que elijas: Claude, ChatGPT, Gemini o un modelo gratis en este PC."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galing ang mga sagot sa AI na pipiliin mo: Claude, ChatGPT, Gemini o libreng model sa PC na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses viennent de l'IA choisie : Claude, ChatGPT, Gemini ou un modèle gratuit sur ce PC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答は選んだ AI から届きます：Claude、ChatGPT、Gemini、またはこの PC の無料モデル。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 AI가 답해요: Claude, ChatGPT, Gemini 또는 이 PC의 무료 모델."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem responde é a IA que você escolher: Claude, ChatGPT, Gemini ou um modelo grátis neste PC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответы дает выбранный тобой ИИ: Claude, ChatGPT, Gemini или бесплатная модель на этом ПК."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答来自你选择的 AI：Claude、ChatGPT、Gemini，或这台电脑上的免费模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答來自你選擇的 AI：Claude、ChatGPT、Gemini，或這台電腦上的免費模型。"
          }
        }
      }
    },
    "Asked once. Your answer stays on this PC." : {
      "comment" : "Party setup on Windows: the note under the birth month and year question.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُسأل مرة واحدة. تبقى إجابتك على هذا الكمبيوتر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur einmal gefragt. Deine Antwort bleibt auf diesem PC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se pregunta una vez. Tu respuesta se queda en este PC."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isang beses lang itatanong. Mananatili sa PC na ito ang sagot mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandé une seule fois. Ta réponse reste sur ce PC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問は一度だけ。回答はこのPCに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번만 물어봐요. 답은 이 PC에만 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perguntado só uma vez. Sua resposta fica neste PC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спросим один раз. Ответ останется на этом ПК."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只问一次。你的回答只保存在这台电脑上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只問一次。你的回答只會保留在這台電腦上。"
          }
        }
      }
    },
    "Back in Tabbi, add it as a new calendar link." : {
      "comment" : "Settings > Connections: the last step of the Google Calendar walkthrough.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في Tabbi، أضفه كرابط تقويم جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ihn dann in Tabbi als neuen Kalenderlink hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vuelta en Tabbi, agrégalo como un enlace de calendario nuevo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagbalik sa Tabbi, idagdag ito bilang bagong calendar link."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De retour dans Tabbi, ajoute-le comme nouveau lien de calendrier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabbiに戻り、新しいカレンダーのリンクとして追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabbi로 돌아와 새 캘린더 링크로 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De volta ao Tabbi, adicione como um novo link de calendário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернись в Tabbi и добавь ее как новую ссылку на календарь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回到 Tabbi，把它添加为新的日历链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回到 Tabbi，把它加入為新的行事曆連結。"
          }
        }
      }
    },
    "Can Tabbi see what's playing?" : {
      "comment" : "Settings > Connections > Something not working?: the check on the Media apps row.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يرى Tabbi ما يُشغَّل؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieht Tabbi, was gerade läuft?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puede Tabbi ver lo que suena?"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakikita ba ng Tabbi kung ano ang tumutugtog?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabbi voit-il ce qui joue ?"
          }
