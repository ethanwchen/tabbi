    "Windows uses %@ itself, so Tabbi can't take it. Record a different shortcut." : {
      "comment" : "Shown under the shortcut recorder when the combination is one Windows reserves (Win+L, Alt+Tab). %@ is the shortcut, such as Win+L.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Windows الاختصار %@ بنفسه، لذا لا يمكن لـ Tabbi أخذه. سجّل اختصارًا مختلفًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows nutzt %@ selbst, Tabbi kann es also nicht übernehmen. Nimm einen anderen Kurzbefehl auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows usa %@ para sí mismo, así que Tabbi no puede usarlo. Graba un atajo distinto."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit ng Windows ang %@ mismo, kaya hindi ito makukuha ng Tabbi. Mag-record ng ibang shortcut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows utilise %@ pour lui-même, Tabbi ne peut donc pas le prendre. Enregistre un autre raccourci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はWindows自身が使うので、Tabbiには使えません。別のショートカットを記録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 키는 Windows가 직접 쓰고 있어서 Tabbi가 가져올 수 없어요. 다른 단축키를 기록해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Windows usa %@ para si mesmo, então o Tabbi não pode usá-lo. Grave um atalho diferente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows использует %@ сам, поэтому Tabbi не может его занять. Запишите другое сочетание."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 由 Windows 自己使用，Tabbi 无法占用。请录制其他快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 由 Windows 自己使用，Tabbi 無法佔用。請錄製其他快速鍵。"
          }
        }
      }
    },
    "Your PC is charging, and %@ is having a sip" : {
