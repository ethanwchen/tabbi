    "Press a new shortcut, or Esc to cancel" : {
      "comment" : "Tooltip on the shortcut recorder field while it records.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط اختصارًا جديدًا، أو Esc للإلغاء"
          }
        },
        "de" : {
          "stringUnit" : {
