    "This account can no longer use Party. Write to %@ if that's a mistake." : {
      "comment" : "Onboarding's party step: the banned state. %@ is the support email.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد هذا الحساب يستطيع استخدام Party. راسل %@ إن كان ذلك خطأ."
          }
        },
        "de" : {
          "stringUnit" : {
