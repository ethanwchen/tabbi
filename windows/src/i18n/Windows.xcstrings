    "Chats stay on this PC, in %@'s own folder. Delete them from History in the Ask AI tab." : {
      "comment" : "Settings > Tabs > Ask AI options: the History footer on Windows. %@ is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى المحادثات على هذا الكمبيوتر، في مجلد %@ الخاص. احذفها من السجل في علامة اسأل AI."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats bleiben auf diesem PC, im Ordner von %@. Lösche sie im Verlauf von KI fragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los chats quedan en este PC, en la carpeta de %@. Bórralos en Historial de Pregunta a la IA."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasa PC na ito ang mga chat, sa sariling folder ng %@. Burahin sa History ng Ask AI tab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chats restent sur ce PC, dans le dossier de %@. Supprime-les dans l'Historique de Demander à l'IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットはこのPCの%@専用フォルダに保存されます。「AIに質問」タブの履歴から削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅은 이 PC의 %@ 폴더에만 저장돼요. AI에게 묻기 탭의 기록에서 삭제할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os chats ficam neste PC, na pasta do %@. Apague-os no Histórico da aba Pergunte à IA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чаты хранятся на этом ПК в папке %@. Удалить их можно в Истории во вкладке «Спросить ИИ»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聊天保存在这台电脑上 %@ 自己的文件夹中。可在“问 AI”标签页的历史记录中删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聊天保存在這台電腦上 %@ 自己的檔案夾。可在「問 AI」的記錄中刪除。"
          }
        }
      }
    },
    "Check that you're online, then check again." : {
      "comment" : "Settings > Connections: what to do when a calendar link couldn't be loaded. The second \"check\" matches the Check again button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من اتصالك بالإنترنت، ثم تحقّق مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob du online bist, und prüfe dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que tienes conexión y vuelve a comprobar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siguraduhing online ka, tapos i-check ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie que tu es en ligne, puis revérifie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンラインか確認してから、もう一度確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온라인인지 확인한 다음 다시 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira se você está online e verifique de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверь, что ты в сети, и проверь еще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认你已联网，然后再检查一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認你已連上網路，然後再檢查一次。"
          }
        }
      }
    },
    "Check your internet connection. You can also set up Party later in its tab." : {
      "comment" : "Onboarding's party step: the server can't be reached.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من اتصالك بالإنترنت. يمكنك أيضًا إعداد Party لاحقًا من تبويبه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüf deine Internetverbindung. Du kannst Party auch später in seinem Tab einrichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba tu conexión a internet. También puedes configurar Party más tarde en su pestaña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie ta connexion internet. Tu peux aussi configurer Party plus tard dans son onglet."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingnan ang koneksyon mo sa internet. Puwede mo ring i-set up ang Party mamaya sa tab nito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネット接続を確認してください。Partyは後でそのタブから設定することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷 연결을 확인해 주세요. Party는 나중에 해당 탭에서 설정할 수도 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique sua conexão com a internet. Você também pode configurar o Party depois, na aba dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверь подключение к интернету. Party можно настроить и позже, в его вкладке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
