          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 앱의 알림이 꺼져 있어요. Windows 설정에서 켜 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações estão desativadas para todos os apps. Ative nas Configurações do Windows."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
