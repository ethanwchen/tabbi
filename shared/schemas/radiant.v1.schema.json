{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabbi.app/schemas/radiant.v1.schema.json",
  "title": "Tabbi Radiant effects",
  "description": "Sources/TabbiKitCore/Pets/PetArt/radiant.json: the Radiant upgrade's effects (RadiantArt). Every per-tick table has one entry per tick of the loop. Shapes and drawings use the sprite legend of docs/study/pets.md.",
  "type": "object",
  "required": ["schema", "loop", "upgradeMultiplier", "slotPriority", "marker", "shapes", "items"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "radiant.v1" },
    "loop": { "type": "integer", "minimum": 1 },
    "upgradeMultiplier": { "type": "integer", "minimum": 2 },
    "slotPriority": { "type": "array", "items": { "enum": ["head", "outfit", "neck", "face", "back", "aura"] }, "uniqueItems": true },
    "marker": { "$ref": "#/$defs/rows" },
    "shapes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["rows", "origin"],
        "additionalProperties": false,
        "properties": { "rows": { "$ref": "#/$defs/rows" }, "origin": { "$ref": "#/$defs/pair" } }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "subtle", "bold"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "pattern": "^(outfit|accessory)\\.[A-Za-z]+$" },
          "subtle": { "$ref": "#/$defs/effect" },
          "bold": { "$ref": "#/$defs/effect" }
        }
      }
    }
  },
  "$defs": {
    "rows": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[.OBSAKWEiLNRPCDTUVGJQYMZzHFIXovkr]+$" } },
    "pair": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
    "role": { "type": "string", "pattern": "^[OBSAKWEiLNRPCDTUVGJQYMZzHFIXovkr]$" },
    "zone": { "enum": ["aboveHead", "topLeft", "topRight", "leftOfHead", "rightOfHead", "leftOfBody", "rightOfBody", "chest"] },
    "anchor": {
      "type": "object",
      "required": ["of", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "of": { "enum": ["item", "itemTip", "pet", "itemRole"] },
        "x": { "type": "integer", "minimum": 0, "maximum": 100 },
        "y": { "type": "integer", "minimum": 0, "maximum": 100 },
        "dx": { "type": "integer" },
        "dy": { "type": "integer" },
        "role": { "$ref": "#/$defs/role" }
      }
    },
    "effect": {
      "type": "object",
      "required": ["name", "placements"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "placements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["zones", "pieces"],
            "additionalProperties": false,
            "properties": {
              "zones": { "type": "array", "items": { "$ref": "#/$defs/zone" }, "uniqueItems": true },
              "pieces": { "type": "array", "items": { "$ref": "#/$defs/piece" } }
            }
          }
        }
      }
    },
    "piece": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["glint", "blink", "hop", "particles", "fixed", "swing", "grid", "trace", "surfaceTrace", "satellite"] },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
        "color": { "$ref": "#/$defs/role" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "mode": { "enum": ["air", "behind", "behindItem", "orbit"] },
        "mirror": { "enum": ["none", "alternate", "item"] }
      }
    }
  }
}
