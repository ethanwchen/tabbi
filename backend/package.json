{
  "name": "tabbi-friends-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Friends / presence / study-party backend for Tabbi (Cloudflare Worker + SQLite Durable Object)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "stats": "node scripts/stats.ts",
    "loadtest": "node scripts/loadtest.ts",
    "e2e": "node scripts/e2e.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260921.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
